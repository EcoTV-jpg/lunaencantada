# Canonical production origin, no trailing slash.
# TODO: set once the final domain is confirmed.
NEXT_PUBLIC_SITE_URL=https://FINAL-DOMAIN.com

# Where availability inquiries are delivered (JSON POST).
# Without it, inquiries are only logged in development and refused in production.
INQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the X-Inquiry-Secret header.
INQUIRY_WEBHOOK_SECRET=
